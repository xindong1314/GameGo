# 围棋小程序服务端配置
# 复制为 server/.env 后按需修改（.env 已在 .gitignore 中，不要提交到仓库）。
# 规则：留空 = 使用默认值；相对路径一律相对于 server/ 目录解析（与启动目录无关）。
# 已在系统环境变量里设置的值优先于本文件。

# ---------------- 网络 ----------------
# 监听端口（默认 8080）
PORT=8080
# 监听地址（默认 0.0.0.0）。部署在 nginx 后面时建议 127.0.0.1，只允许本机的 nginx 访问；
# 本地开发要让手机真机访问时保持 0.0.0.0。
HOST=0.0.0.0
# 对外访问地址，用来生成头像的完整 URL（默认 http://localhost:8080）。
# 上线改为 https://你的域名；本地开发改为 http://电脑局域网IP:8080。结尾不要带 /。
PUBLIC_BASE_URL=http://localhost:8080

# ---------------- 数据 ----------------
# 数据目录（默认 ./data）：SQLite 数据库 gamego.db 与头像目录 avatars/ 都放在这里，需定期备份。
DATA_DIR=./data

# ---------------- 微信登录 ----------------
# 小程序的 AppID 与 AppSecret（微信公众平台 → 开发管理 → 开发设置）。
# AppSecret 只能放在服务端，绝不能写进小程序代码。
# 两项有一项为空时，/api/auth/login 返回 503 wx_not_configured，客户端在开发模式下改走开发登录。
WX_APPID=
WX_SECRET=
# 开发登录（默认 0）。1 = 开放 /api/auth/dev-login：任何人凭一个设备号就能登录。
# 只用于本地开发，正式上线必须为 0！NODE_ENV=production 或 PUBLIC_BASE_URL 是 https 时开着会拒绝启动，
# 临时测试服确实需要时再设 DEV_LOGIN_ALLOW_PRODUCTION=1。
DEV_LOGIN=0
# DEV_LOGIN_ALLOW_PRODUCTION=0

# ---------------- 内容安全 ----------------
# 昵称与头像会显示在排行榜上，服务端用微信 msgSecCheck / imgSecCheck 再检测一次（需要 WX_APPID/WX_SECRET）：
#   off    不检测
#   on     检测（默认）：违规的拒绝；微信那边出错（接口异常、超时、次数用完）时放行并记日志（含 errcode）
#   strict 与 on 相同，但微信那边出错时也拒绝（先用正式 AppID 实测再用；未发布的小程序每天只能检测 100 次昵称）
# 两种模式下，头像超出送检限制（1MB、750×1334）、昵称检测报 61010（用户近两小时没打开过小程序）都一律拒绝。
# 头像用的 imgSecCheck 是微信已停止更新的 1.0 接口，只能算尽力而为，见 docs/deploy.md 第 4 节。
SEC_CHECK=on

# ---------------- AI（KataGo） ----------------
# KataGo 可执行文件、神经网络权重、分析引擎配置，三项都有值才启用 KataGo。
# KATAGO_PATH 可写绝对路径、相对 server/ 的路径（如 ./katago/katago），或 PATH 里的命令名 katago。
KATAGO_PATH=
KATAGO_MODEL=
# 默认 ./katago/analysis.cfg（仓库自带的模板）
KATAGO_CONFIG=./katago/analysis.cfg
# 未配置 KataGo 时是否启用内置弱 AI（默认 0，仅供开发调试）
AI_FALLBACK=0

# ---------------- 用时（读秒） ----------------
# 格式：基本时间秒数,读秒次数,每次读秒秒数。默认：
#   9 路 3 分钟 + 3×20 秒；13 路 6 分钟 + 3×30 秒；19 路 10 分钟 + 3×30 秒
# 读秒次数为 0 表示包干制（基本时间用完即超时）。
TC_9=180,3,20
TC_13=360,3,30
TC_19=600,3,30

# ---------------- 排行榜 ----------------
# 数子终局的排位赛至少要有多少手落子（不含停一手）才计入统计（默认 10）：开局就双方停一手刷不了胜局。
# 认输、超时不看这个数：双方都下过一手就计入（不能靠早早认输躲开强手保连胜），自己一手没下就认输/超时不计。
MIN_MOVES_RANKED=10
# 同一对手 24 小时内最多有几局排位赛计入统计（默认 3，0 = 不限）：防止两个账号反复匹配互刷连胜
RANKED_PAIR_DAILY_MAX=3
# 胜率榜上榜所需的最少排位局数（默认 10）
MIN_GAMES_WINRATE=10

# ---------------- 日志 ----------------
# 日志级别：debug / info / warn / error（默认 info；debug 会记录每个 HTTP 请求）
LOG_LEVEL=info
