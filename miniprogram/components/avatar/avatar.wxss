:host {
  display: inline-block;
  flex-shrink: 0;
  line-height: 0;
}

.avatar {
  position: relative;
  border-radius: 50%;
  overflow: hidden;
  background: #e8dcc8;
}

.img {
  display: block;
  width: 100%;
  height: 100%;
}

.initial {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  color: #fff;
  font-weight: bold;
  line-height: 1;
}
