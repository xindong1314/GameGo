<template name="side">
  <view class="side">
    <avatar src="{{avatarUrl}}" name="{{nickname}}" size="{{64}}" />
    <view class="side-name">
      <view class="stone stone-{{color}}"></view>
      <text class="name">{{nickname}}</text>
      <text wx:if="{{isMe}}" class="tag">我</text>
    </view>
  </view>
</template>

<view class="page">
  <view wx:if="{{loadError}}" class="state-box">
    <view class="state-text">{{loadError}}</view>
    <view class="state-actions">
      <button class="btn primary" bindtap="onRetry">重试</button>
      <button class="btn" bindtap="onHome">返回首页</button>
    </view>
  </view>

  <view wx:elif="{{!loaded}}" class="state-box">
    <view class="state-text muted">正在加载棋谱…</view>
  </view>

  <block wx:else>
    <view class="header">
      <view class="players">
        <template is="side" data="{{...black, color: 1}}" />
        <text class="vs">VS</text>
        <template is="side" data="{{...white, color: 2}}" />
      </view>
      <view class="result-line">
        <text wx:if="{{myResultText}}" class="my-result {{myResultTone}}">{{myResultText}}</text>
        <text class="result">{{resultLabel}}</text>
      </view>
      <view class="info">{{infoText}}<text wx:if="{{dateText}}"> · {{dateText}}</text></view>
      <view wx:if="{{error}}" class="error">{{error}}</view>
    </view>

    <goboard size="{{size}}" cells="{{cells}}" lastIdx="{{lastIdx}}" marks="{{marks}}" disabled="{{true}}" />

    <view class="move-line">
      <text class="move-text">{{moveText}}</text>
      <text class="caps">提子 黑 {{captures[1]}} · 白 {{captures[2]}}</text>
    </view>
    <view wx:if="{{finalText}}" class="final">{{finalText}}</view>

    <view class="slider-box">
      <slider
        min="0"
        max="{{total > 0 ? total : 1}}"
        step="1"
        value="{{k}}"
        disabled="{{total === 0}}"
        activeColor="#3b2a1a"
        backgroundColor="#e6dccb"
        block-color="#3b2a1a"
        block-size="22"
        bindchanging="onSliding"
        bindchange="onSlide"
      />
      <text class="progress">{{k}} / {{total}}</text>
    </view>

    <view class="nav ui-btn-row">
      <button class="btn" disabled="{{!canPrev}}" bindtap="onFirst">首手</button>
      <button class="btn" disabled="{{!canPrev}}" bindtap="onPrev">上一手</button>
      <button class="btn" disabled="{{!canNext}}" bindtap="onNext">下一手</button>
      <button class="btn" disabled="{{!canNext}}" bindtap="onLast">末手</button>
    </view>

    <view class="nav ui-btn-row extra">
      <button class="btn" bindtap="onCopySgf">复制 SGF 棋谱</button>
      <button class="btn" bindtap="onHome">返回首页</button>
    </view>
  </block>
</view>
