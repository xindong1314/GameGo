.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 40rpx 40rpx calc(48rpx + env(safe-area-inset-bottom));
}

/* ---------- 房号 ---------- */
.code-card {
  text-align: center;
}

.code-label {
  font-size: 26rpx;
  color: #7a6248;
}

.code {
  display: flex;
  justify-content: center;
  margin: 24rpx 0;
}

/* 间距用 margin 而不是 flex 的 gap：gap 需要 iOS 14.5+ 的 WebView */
.digit + .digit {
  margin-left: 14rpx;
}

.digit {
  width: 80rpx;
  height: 104rpx;
  line-height: 104rpx;
  border-radius: 12rpx;
  font-size: 60rpx;
  font-weight: bold;
  color: #fff;
  background: #3b2a1a;
  font-variant-numeric: tabular-nums;
}

.room-meta {
  font-size: 28rpx;
}

.copy {
  display: inline-block;
  margin-top: 20rpx;
  padding: 10rpx 28rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #3b2a1a;
  border: 2rpx solid #c9b391;
}

.copy-hover {
  background: #f5efe6;
}

/* ---------- 等待动画 ---------- */
.waiting {
  margin: 56rpx 0 48rpx;
  text-align: center;
}

.dots {
  display: flex;
  justify-content: center;
}

.d + .d {
  margin-left: 18rpx;
}

.d {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: #3b2a1a;
  animation: bounce 1.2s ease-in-out infinite;
}

.d.d2 {
  background: #fff;
  border: 2rpx solid #c9b391;
  animation-delay: 0.2s;
}

.d.d3 {
  animation-delay: 0.4s;
}

@keyframes bounce {
  0%, 80%, 100% { transform: translateY(0); opacity: 0.5; }
  40% { transform: translateY(-16rpx); opacity: 1; }
}

.waiting-text {
  margin-top: 24rpx;
  font-size: 32rpx;
}

.expire {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #a08c6c;
  font-variant-numeric: tabular-nums;
}

.actions {
  display: flex;
  flex-direction: column;
}

.actions .btn + .btn {
  margin-top: 24rpx;
}

.btn.big {
  height: 96rpx;
  line-height: 96rpx;
  font-size: 34rpx;
  font-weight: bold;
}

.note {
  margin-top: 32rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #a08c6c;
  text-align: center;
}

/* ---------- 受邀 ---------- */
.invite-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 56rpx;
  padding-bottom: 48rpx;
  margin-bottom: 48rpx;
}

.owner-name {
  margin-top: 24rpx;
  font-size: 40rpx;
  font-weight: bold;
}

.invite-text {
  margin-top: 8rpx;
  color: #7a6248;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  margin-top: 24rpx;
}

/* 可能换行：每个标签四周各 8rpx，相邻标签之间合计 16rpx */
.chip {
  margin: 8rpx;
  padding: 8rpx 24rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  background: #f5efe6;
  border: 2rpx solid #e2d5bf;
}

.room-no {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #a08c6c;
}

/* ---------- 输入房号 ---------- */
.entry-title {
  font-size: 40rpx;
  font-weight: bold;
  text-align: center;
}

.entry-desc {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #7a6248;
  text-align: center;
}

.code-input {
  margin-top: 40rpx;
  height: 112rpx;
  border: 2rpx solid #c9b391;
  border-radius: 16rpx;
  background: #fff;
  text-align: center;
  font-size: 56rpx;
  font-weight: bold;
  letter-spacing: 20rpx;
}

.code-placeholder {
  font-size: 30rpx;
  font-weight: normal;
  letter-spacing: 0;
  color: #b9a88c;
}

.entry-error {
  min-height: 48rpx;
  line-height: 48rpx;
  margin: 8rpx 0 16rpx;
  font-size: 26rpx;
  color: #b3261e;
  text-align: center;
}

/* ---------- 状态页 ---------- */
.state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 160rpx;
}

.state-icon {
  width: 96rpx;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 50%;
  text-align: center;
  font-size: 56rpx;
  font-weight: bold;
  color: #fff;
  background: #c9b391;
}

.state-text {
  margin: 32rpx 0 48rpx;
  font-size: 32rpx;
  text-align: center;
}

.state-btn {
  width: 440rpx;
  margin-bottom: 24rpx;
}
