.page {
  padding: 32rpx 40rpx calc(200rpx + env(safe-area-inset-bottom));
}

.section {
  margin-bottom: 40rpx;
}

.section-title {
  margin-bottom: 16rpx;
  color: #7a6248;
}

.seg-sub {
  font-size: 20rpx;
  opacity: 0.7;
}

.levels {
  display: flex;
  flex-direction: column;
}

.level + .level {
  margin-top: 16rpx;
}

.levels.disabled {
  opacity: 0.45;
}

.level {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  border-radius: 16rpx;
  border: 2rpx solid #e2d5bf;
  background: #fff;
}

.level.active {
  border-color: #3b2a1a;
  box-shadow: 0 0 0 2rpx #3b2a1a inset;
}

.level-main {
  flex: 1;
  min-width: 0;
}

.level-name {
  font-size: 32rpx;
  font-weight: bold;
}

.level-desc {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #7a6248;
}

.level-check {
  flex: none;
  width: 48rpx;
  text-align: right;
  font-size: 36rpx;
  color: #3b2a1a;
}

.unavailable {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #8a1f17;
  background: #fbe9e7;
}

.link {
  flex: none;
  margin-left: 16rpx;
  color: #2a6fb0;
}

.note {
  font-size: 24rpx;
  line-height: 1.6;
  color: #a08c6c;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx 40rpx calc(24rpx + env(safe-area-inset-bottom));
  background: #f5efe6;
  box-shadow: 0 -8rpx 24rpx rgba(59, 42, 26, 0.08);
}

.btn.big {
  height: 96rpx;
  line-height: 96rpx;
  font-size: 34rpx;
  font-weight: bold;
}
